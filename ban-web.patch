@@ -0,0 +1,358 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { ApiError, api } from '../lib/api';
+import { formatDate, formatMoney, normalize } from '../lib/format';
+import type { HoaDonChiTiet, SanPham, TaoHoaDonRequest, TinhTien } from '../lib/types';
+import { ErrorState, Loading, Modal, useLoad, useToast } from '../components/ui';
+
+interface CartLine {
+  sp: SanPham;
+  soLuong: number;
+}
+
+/** Màn hình bán hàng: chọn sản phẩm → giỏ hàng → khách hàng / khuyến mãi → lập hóa đơn. */
+export default function BanHangPage() {
+  const toast = useToast();
+  const products = useLoad(() => api.sanPham(), []);
+  const customers = useLoad(() => api.khachHang(), []);
+  const promos = useLoad(() => api.khuyenMaiHieuLuc(), []);
+
+  const [q, setQ] = useState('');
+  const [cart, setCart] = useState<CartLine[]>([]);
+  const [maKH, setMaKH] = useState('');
+  const [maKM, setMaKM] = useState('');
+  const [preview, setPreview] = useState<TinhTien | null>(null);
+  const [previewError, setPreviewError] = useState<string | null>(null);
+  const [previewing, setPreviewing] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [done, setDone] = useState<HoaDonChiTiet | null>(null);
+
+  const filtered = useMemo(() => {
+    const k = normalize(q);
+    return (products.data ?? [])
+      .filter((s) => !k || normalize(`${s.maSanPham} ${s.tenSanPham}`).includes(k))
+      .slice(0, 60);
+  }, [products.data, q]);
+
+  const request: TaoHoaDonRequest = useMemo(
+    () => ({
+      maKhachHang: maKH || null,
+      maKhuyenMai: maKM || null,
+      items: cart.map((l) => ({ maSanPham: l.sp.maSanPham, soLuong: l.soLuong })),
+    }),
+    [cart, maKH, maKM],
+  );
+
+  // Hỏi server tính tiền (giá, tồn kho, khuyến mãi) mỗi khi giỏ hàng đổi – chờ 300ms để đỡ gọi liên tục
+  useEffect(() => {
+    if (request.items.length === 0 || request.items.some((i) => !(i.soLuong >= 1))) {
+      setPreview(null);
+      setPreviewError(null);
+      return;
+    }
+    let cancelled = false;
+    setPreviewing(true);
+    const t = setTimeout(() => {
+      api
+        .xemTruocHoaDon(request)
+        .then((p) => {
+          if (cancelled) return;
+          setPreview(p);
+          setPreviewError(null);
+        })
+        .catch((e: Error) => {
+          if (cancelled) return;
+          setPreview(null);
+          setPreviewError(e.message);
+        })
+        .finally(() => !cancelled && setPreviewing(false));
+    }, 300);
+    return () => {
+      cancelled = true;
+      clearTimeout(t);
+    };
+  }, [request]);
+
+  function add(sp: SanPham) {
+    if (sp.soLuongTon <= 0) {
+      toast.error(`${sp.tenSanPham} đã hết hàng`);
+      return;
+    }
+    setCart((c) => {
+      const found = c.find((l) => l.sp.maSanPham === sp.maSanPham);
+      if (found) {
+        return c.map((l) =>
+          l.sp.maSanPham === sp.maSanPham ? { ...l, soLuong: Math.min(l.soLuong + 1, sp.soLuongTon) } : l,
+        );
+      }
+      return [...c, { sp, soLuong: 1 }];
+    });
+  }
+
+  function setQty(ma: string, value: number) {
+    setCart((c) => c.map((l) => (l.sp.maSanPham === ma ? { ...l, soLuong: value } : l)));
+  }
+
+  function remove(ma: string) {
+    setCart((c) => c.filter((l) => l.sp.maSanPham !== ma));
+  }
+
+  function reset() {
+    setCart([]);
+    setMaKH('');
+    setMaKM('');
+    setPreview(null);
+    setPreviewError(null);
+  }
+
+  async function submit() {
+    setSaving(true);
+    try {
+      const hd = await api.taoHoaDon(request);
+      setDone(hd);
+      reset();
+      products.reload(); // tồn kho đã thay đổi
+    } catch (e) {
+      toast.error(e instanceof ApiError ? e.message : 'Không lập được hóa đơn.');
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  const localTotal = cart.reduce((sum, l) => sum + l.sp.gia * (l.soLuong || 0), 0);
+  const overStock = cart.find((l) => l.soLuong > l.sp.soLuongTon);
+  const invalidQty = cart.some((l) => !Number.isInteger(l.soLuong) || l.soLuong < 1);
+  const canSubmit = cart.length > 0 && !overStock && !invalidQty && !!preview && !previewError && !previewing && !saving;
+
+  if (products.loading && !products.data) return <Loading />;
+  if (products.error) return <ErrorState message={products.error} onRetry={products.reload} />;
+
+  return (
+    <div className="page">
+      <header className="page-head">
+        <div>
+          <h1>Lập hóa đơn</h1>
+          <p className="muted">Bấm vào sản phẩm để thêm vào hóa đơn. Giá và khuyến mãi được máy chủ tính lại khi lưu.</p>
+        </div>
+      </header>
+
+      <div className="pos">
+        <section className="card pos-products">
+          <input
+            className="search"
+            placeholder="Tìm sản phẩm theo mã hoặc tên…"
+            value={q}
+            onChange={(e) => setQ(e.target.value)}
+            aria-label="Tìm sản phẩm để bán"
+          />
+          <div className="product-grid">
+            {filtered.map((s) => (
+              <button
+                key={s.maSanPham}
+                className={`product-tile${s.soLuongTon <= 0 ? ' disabled' : ''}`}
+                onClick={() => add(s)}
+                title={s.moTa ?? s.tenSanPham}
+              >
+                <strong>{s.tenSanPham}</strong>
+                <span className="price">{formatMoney(s.gia)}</span>
+                <small className={s.soLuongTon <= 0 ? 'text-danger' : s.soLuongTon <= 30 ? 'text-warn' : 'muted'}>
+                  {s.soLuongTon <= 0 ? 'Hết hàng' : `Tồn ${s.soLuongTon} ${s.donViTinh ?? ''}`}
+                </small>
+              </button>
+            ))}
+            {filtered.length === 0 && <p className="muted">Không tìm thấy sản phẩm.</p>}
+          </div>
+        </section>
+
+        <section className="card pos-cart">
+          <h2>Hóa đơn</h2>
+          {cart.length === 0 ? (
+            <p className="muted empty-cart">Chưa có sản phẩm nào.</p>
+          ) : (
+            <table className="table table-compact">
+              <thead>
+                <tr>
+                  <th>Sản phẩm</th>
+                  <th className="num">SL</th>
+                  <th className="num">Thành tiền</th>
+                  <th aria-label="Xóa" />
+                </tr>
+              </thead>
+              <tbody>
+                {cart.map((l) => (
+                  <tr key={l.sp.maSanPham}>
+                    <td>
+                      {l.sp.tenSanPham}
+                      <small className="muted block">{formatMoney(l.sp.gia)}</small>
+                      {l.soLuong > l.sp.soLuongTon && (
+                        <small className="text-danger block">Chỉ còn {l.sp.soLuongTon}</small>
+                      )}
+                    </td>
+                    <td className="num">
+                      <input
+                        className="qty"
+                        type="number"
+                        min={1}
+                        max={l.sp.soLuongTon}
+                        value={Number.isNaN(l.soLuong) ? '' : l.soLuong}
+                        onChange={(e) => setQty(l.sp.maSanPham, e.target.valueAsNumber)}
+                        aria-label={`Số lượng ${l.sp.tenSanPham}`}
+                      />
+                    </td>
+                    <td className="num">{formatMoney(l.sp.gia * (l.soLuong || 0))}</td>
+                    <td>
+                      <button className="icon-btn" onClick={() => remove(l.sp.maSanPham)} aria-label={`Bỏ ${l.sp.tenSanPham}`}>
+                        ×
+                      </button>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          )}
+
+          <label className="field">
+            <span>Khách hàng</span>
+            <select value={maKH} onChange={(e) => setMaKH(e.target.value)}>
+              <option value="">Khách lẻ</option>
+              {(customers.data ?? []).map((k) => (
+                <option key={k.maKhachHang} value={k.maKhachHang}>
+                  {k.maKhachHang} – {k.hoTen}
+                  {k.soDienThoai ? ` (${k.soDienThoai})` : ''}
+                </option>
+              ))}
+            </select>
+          </label>
+
+          <label className="field">
+            <span>Khuyến mãi</span>
+            <select value={maKM} onChange={(e) => setMaKM(e.target.value)}>
+              <option value="">Không áp dụng</option>
+              {(promos.data ?? []).map((k) => (
+                <option key={k.maKhuyenMai} value={k.maKhuyenMai}>
+                  {k.maKhuyenMai} – {k.tenKhuyenMai} (giảm {k.phanTramGiam}%{k.dieuKien ? `, đơn ${k.dieuKien}` : ''})
+                </option>
+              ))}
+            </select>
+            {promos.data && promos.data.length === 0 && <em className="field-hint">Hôm nay không có khuyến mãi nào.</em>}
+          </label>
+
+          <div className="totals">
+            <div>
+              <span>Tổng tiền</span>
+              <strong>{formatMoney(preview?.tongTien ?? localTotal)}</strong>
+            </div>
+            <div>
+              <span>Giảm giá{preview?.phanTramGiam ? ` (${preview.phanTramGiam}%)` : ''}</span>
+              <strong>{formatMoney(preview?.tienGiam ?? 0)}</strong>
+            </div>
+            <div className="grand">
+              <span>Khách trả</span>
+              <strong>{formatMoney(preview?.thanhTien ?? localTotal)}</strong>
+            </div>
+          </div>
+
+          {previewError && (
+            <div className="alert alert-error" role="alert">
+              {previewError}
+            </div>
+          )}
+
+          <div className="pos-actions">
+            <button className="btn" onClick={reset} disabled={cart.length === 0 || saving}>
+              Hủy
+            </button>
+            <button className="btn btn-primary" onClick={submit} disabled={!canSubmit}>
+              {saving ? 'Đang lưu…' : previewing ? 'Đang tính…' : 'Lập hóa đơn'}
+            </button>
+          </div>
+        </section>
+      </div>
+
+      {done && (
+        <Modal
+          title={`Đã lập hóa đơn ${done.hoaDon.maHoaDon}`}
+          onClose={() => setDone(null)}
+          footer={
+            <>
+              <Link className="btn" to="/hoa-don">
+                Xem danh sách hóa đơn
+              </Link>
+              <button className="btn btn-primary" onClick={() => setDone(null)} autoFocus>
+                Lập hóa đơn mới
+              </button>
+            </>
+          }
+        >
+          <HoaDonView hd={done} />
+        </Modal>
+      )}
+    </div>
+  );
+}
+
+export function HoaDonView({ hd }: { hd: HoaDonChiTiet }) {
+  const h = hd.hoaDon;
+  return (
+    <div className="invoice">
+      <dl className="meta">
+        <div>
+          <dt>Ngày</dt>
+          <dd>{formatDate(h.thoiGian)}</dd>
+        </div>
+        <div>
+          <dt>Khách hàng</dt>
+          <dd>{h.maKhachHang ? `${h.tenKhachHang} (${h.maKhachHang})` : 'Khách lẻ'}</dd>
+        </div>
+        <div>
+          <dt>Nhân viên</dt>
+          <dd>
+            {h.tenNhanVien} ({h.maNhanVien})
+          </dd>
+        </div>
+        <div>
+          <dt>Khuyến mãi</dt>
+          <dd>{h.maKhuyenMai ?? '—'}</dd>
+        </div>
+      </dl>
+      <table className="table table-compact">
+        <thead>
+          <tr>
+            <th>Sản phẩm</th>
+            <th className="num">SL</th>
+            <th className="num">Đơn giá</th>
+            <th className="num">Thành tiền</th>
+          </tr>
+        </thead>
+        <tbody>
+          {hd.items.map((i) => (
+            <tr key={i.maSanPham}>
+              <td>
+                {i.tenSanPham} <small className="muted">{i.maSanPham}</small>
+              </td>
+              <td className="num">
+                {i.soLuong} {i.donViTinh ?? ''}
+              </td>
+              <td className="num">{formatMoney(i.donGia)}</td>
+              <td className="num">{formatMoney(i.thanhTien)}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <div className="totals">
+        <div>
+          <span>Tổng tiền</span>
+          <strong>{formatMoney(h.tongTien)}</strong>
+        </div>
+        <div>
+          <span>Giảm giá</span>
+          <strong>{formatMoney(h.tienGiam)}</strong>
+        </div>
+        <div className="grand">
+          <span>Thành tiền</span>
+          <strong>{formatMoney(h.thanhTien)}</strong>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/web/frontend/src/pages/DashboardPage.tsx b/web/frontend/src/pages/DashboardPage.tsx
new file mode 100644
index 0000000..228ed23
--- /dev/null
+++ b/web/frontend/src/pages/DashboardPage.tsx
@@ -0,0 +1,149 @@
+import { Link } from 'react-router-dom';
+import { api } from '../lib/api';
+import { useAuth } from '../lib/auth';
+import { formatDate, formatMoney, formatMoneyShort, formatNumber } from '../lib/format';
+import { ErrorState, Loading, useLoad } from '../components/ui';
+
+export default function DashboardPage() {
+  const { user, isQuanLy } = useAuth();
+  const { data, error, loading, reload } = useLoad(() => api.dashboard(), []);
+
+  return (
+    <div className="page">
+      <header className="page-head">
+        <div>
+          <h1>Xin chào, {user?.hoTen || user?.maNhanVien}</h1>
+          <p className="muted">
+            {isQuanLy ? 'Tình hình cửa hàng hôm nay' : 'Chúc bạn một ca làm việc thuận lợi'}
+            {data && ` · ${formatDate(data.ngay)}`}
+          </p>
+        </div>
+        <div className="actions">
+          <button className="btn" onClick={reload} disabled={loading}>
+            Làm mới
+          </button>
+          <Link className="btn btn-primary" to="/ban-hang">
+            + Lập hóa đơn
+          </Link>
+        </div>
+      </header>
+
+      {loading && !data && <Loading text="Đang tải số liệu…" />}
+      {error && <ErrorState message={error} onRetry={reload} />}
+
+      {data && (
+        <>
+          <section className="stats">
+            {isQuanLy ? (
+              <>
+                <Stat
+                  label="Doanh thu hôm nay"
+                  value={formatMoneyShort(data.doanhThuHomNay)}
+                  title={formatMoney(data.doanhThuHomNay)}
+                  sub={`${data.hoaDonHomNay} hóa đơn`}
+                />
+                <Stat
+                  label="Doanh thu tháng này"
+                  value={formatMoneyShort(data.doanhThuThangNay)}
+                  title={formatMoney(data.doanhThuThangNay)}
+                  sub={`${formatNumber(data.hoaDonThangNay)} hóa đơn`}
+                />
+              </>
+            ) : (
+              <>
+                <Stat label="Hóa đơn hôm nay" value={formatNumber(data.hoaDonHomNay)} sub="toàn cửa hàng" />
+                <Stat label="Hóa đơn tháng này" value={formatNumber(data.hoaDonThangNay)} sub="toàn cửa hàng" />
+              </>
+            )}
+            <Stat
+              label="Sản phẩm"
+              value={formatNumber(data.tongSanPham)}
+              sub={data.soSapHetHang > 0 ? `${data.soSapHetHang} sắp hết hàng` : 'Tồn kho ổn định'}
+              warn={data.soSapHetHang > 0}
+            />
+            <Stat label="Khách hàng" value={formatNumber(data.tongKhachHang)} sub="khách hàng thành viên" />
+          </section>
+
+          <section className="grid-2">
+            <div className="card">
+              <div className="card-head">
+                <h2>Sắp hết hàng</h2>
+                <span className="badge badge-warn">{data.soSapHetHang}</span>
+              </div>
+              <p className="muted small">Tồn kho từ {data.nguongSapHetHang} trở xuống</p>
+              {data.sapHetHang.length === 0 ? (
+                <p className="muted">Không có sản phẩm nào sắp hết hàng.</p>
+              ) : (
+                <ul className="list">
+                  {data.sapHetHang.map((s) => (
+                    <li key={s.maSanPham}>
+                      <div>
+                        <strong>{s.tenSanPham}</strong>
+                        <small className="muted">{s.maSanPham}</small>
+                      </div>
+                      <span className={`pill ${s.soLuongTon <= 0 ? 'pill-danger' : 'pill-warn'}`}>
+                        {s.soLuongTon <= 0 ? 'Hết hàng' : `Còn ${s.soLuongTon} ${s.donViTinh ?? ''}`}
+                      </span>
+                    </li>
+                  ))}
+                </ul>
+              )}
+              {data.soSapHetHang > data.sapHetHang.length && (
+                <p className="muted small">và {data.soSapHetHang - data.sapHetHang.length} sản phẩm khác…</p>
+              )}
+              {isQuanLy && (
+                <Link to="/san-pham" className="link small">
+                  Xem sản phẩm →
+                </Link>
+              )}
+            </div>
+
+            <div className="card">
+              <div className="card-head">
+                <h2>Lô hàng sắp hết hạn</h2>
+                <span className="badge badge-danger">{data.soLoSapHetHan}</span>
+              </div>
+              <p className="muted small">Hết hạn trong {data.soNgayCanhBaoHetHan} ngày tới hoặc vừa hết hạn</p>
+              {data.sapHetHan.length === 0 ? (
+                <p className="muted">Không có lô hàng nào sắp hết hạn.</p>
+              ) : (
+                <ul className="list">
+                  {data.sapHetHan.map((h) => (
+                    <li key={h.maHang}>
+                      <div>
+                        <strong>{h.tenSanPham}</strong>
+                        <small className="muted">
+                          Lô {h.maHang} · {h.soLuong} · HSD {formatDate(h.hanSuDung)}
+                        </small>
+                      </div>
+                      <span className={`pill ${h.soNgayConLai <= 0 ? 'pill-danger' : 'pill-warn'}`}>
+                        {h.soNgayConLai < 0
+                          ? `Quá hạn ${-h.soNgayConLai} ngày`
+                          : h.soNgayConLai === 0
+                            ? 'Hết hạn hôm nay'
+                            : `Còn ${h.soNgayConLai} ngày`}
+                      </span>
+                    </li>
+                  ))}
+                </ul>
+              )}
+              {data.soLoSapHetHan > data.sapHetHan.length && (
+                <p className="muted small">và {data.soLoSapHetHan - data.sapHetHan.length} lô khác…</p>
+              )}
+            </div>
+          </section>
+        </>
+      )}
+    </div>
+  );
+}
+
+function Stat({ label, value, sub, warn, title }: { label: string; value: string; sub: string; warn?: boolean; title?: string }) {
+  return (
+    <div className="stat" title={title}>
+      <span className="stat-label">{label}</span>
+      <strong className="stat-value">{value}</strong>
+      <span className={`stat-sub${warn ? ' warn' : ''}`}>{sub}</span>
+    </div>
+  );
+}
diff --git a/web/frontend/src/pages/HoaDonPage.tsx b/web/frontend/src/pages/HoaDonPage.tsx
new file mode 100644
index 0000000..fef8c31
--- /dev/null
+++ b/web/frontend/src/pages/HoaDonPage.tsx
@@ -0,0 +1,139 @@
+import { useState, type FormEvent } from 'react';
+import { api } from '../lib/api';
+import { useAuth } from '../lib/auth';
+import { formatDate, formatMoney } from '../lib/format';
+import type { HoaDonChiTiet } from '../lib/types';
+import { Empty, ErrorState, Loading, Modal, useLoad, useToast } from '../components/ui';
+import { HoaDonView } from './BanHangPage';
+
+const PAGE_SIZE = 20;
+
+export default function HoaDonPage() {
+  const { isQuanLy } = useAuth();
+  const toast = useToast();
+  const [filter, setFilter] = useState({ q: '', tuNgay: '', denNgay: '' });
+  const [applied, setApplied] = useState(filter);
+  const [page, setPage] = useState(0);
+  const [detail, setDetail] = useState<HoaDonChiTiet | null>(null);
+
+  const list = useLoad(
+    () => api.hoaDon({ ...applied, page, size: PAGE_SIZE }),
+    [applied.q, applied.tuNgay, applied.denNgay, page],
+  );
+
+  function search(e: FormEvent) {
+    e.preventDefault();
+    setPage(0);
+    setApplied(filter);
+  }
+
+  async function open(ma: string) {
+    try {
+      setDetail(await api.chiTietHoaDon(ma));
+    } catch (e) {
+      toast.error((e as Error).message);
+    }
+  }
+
+  const totalPages = list.data ? Math.max(1, Math.ceil(list.data.total / PAGE_SIZE)) : 1;
+
+  return (
+    <div className="page">
+      <header className="page-head">
+        <div>
+          <h1>Hóa đơn</h1>
+          <p className="muted">
+            {isQuanLy ? 'Tất cả hóa đơn của cửa hàng' : 'Hóa đơn do bạn lập'}
+            {list.data && ` · ${list.data.total} hóa đơn`}
+          </p>
+        </div>
+      </header>
+
+      <form className="toolbar" onSubmit={search}>
+        <input
+          className="search"
+          placeholder="Mã hóa đơn hoặc mã khách hàng"
+          value={filter.q}
+          onChange={(e) => setFilter({ ...filter, q: e.target.value })}
+          aria-label="Tìm hóa đơn"
+        />
+        <label className="inline">
+          Từ
+          <input type="date" value={filter.tuNgay} onChange={(e) => setFilter({ ...filter, tuNgay: e.target.value })} />
+        </label>
+        <label className="inline">
+          Đến
+          <input type="date" value={filter.denNgay} onChange={(e) => setFilter({ ...filter, denNgay: e.target.value })} />
+        </label>
+        <button className="btn" type="submit">
+          Tìm
+        </button>
+      </form>
+
+      {list.loading && !list.data && <Loading />}
+      {list.error && <ErrorState message={list.error} onRetry={list.reload} />}
+      {list.data && list.data.items.length === 0 && <Empty>Không có hóa đơn nào.</Empty>}
+      {list.data && list.data.items.length > 0 && (
+        <>
+          <div className="table-wrap">
+            <table className="table">
+              <thead>
+                <tr>
+                  <th>Mã</th>
+                  <th>Ngày</th>
+                  <th>Khách hàng</th>
+                  {isQuanLy && <th>Nhân viên</th>}
+                  <th className="num">Tổng tiền</th>
+                  <th className="num">Giảm</th>
+                  <th className="num">Thành tiền</th>
+                </tr>
+              </thead>
+              <tbody>
+                {list.data.items.map((h) => (
+                  <tr key={h.maHoaDon} className="clickable" onClick={() => open(h.maHoaDon)}>
+                    <td className="mono">{h.maHoaDon}</td>
+                    <td>{formatDate(h.thoiGian)}</td>
+                    <td>{h.maKhachHang ? h.tenKhachHang || h.maKhachHang : <span className="muted">Khách lẻ</span>}</td>
+                    {isQuanLy && <td>{h.tenNhanVien || h.maNhanVien}</td>}
+                    <td className="num">{formatMoney(h.tongTien)}</td>
+                    <td className="num">
+                      {h.tienGiam > 0 ? (
+                        <span title={h.maKhuyenMai ?? ''}>-{formatMoney(h.tienGiam)}</span>
+                      ) : (
+                        <span className="muted">—</span>
+                      )}
+                    </td>
+                    <td className="num">
+                      <strong>{formatMoney(h.thanhTien)}</strong>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <div className="pager">
+            <button className="btn btn-sm" disabled={page === 0 || list.loading} onClick={() => setPage((p) => p - 1)}>
+              ← Trước
+            </button>
+            <span>
+              Trang {page + 1} / {totalPages}
+            </span>
+            <button
+              className="btn btn-sm"
+              disabled={page + 1 >= totalPages || list.loading}
+              onClick={() => setPage((p) => p + 1)}
+            >
+              Sau →
+            </button>
+          </div>
+        </>
+      )}
+
+      {detail && (
+        <Modal title={`Hóa đơn ${detail.hoaDon.maHoaDon}`} onClose={() => setDetail(null)} wide>
+          <HoaDonView hd={detail} />
+        </Modal>
+      )}
+    </div>
+  );
+}
diff --git a/web/frontend/src/pages/LoginPage.tsx b/web/frontend/src/pages/LoginPage.tsx
new file mode 100644
index 0000000..88517d9
--- /dev/null
+++ b/web/frontend/src/pages/LoginPage.tsx
@@ -0,0 +1,76 @@
+import { useState, type FormEvent } from 'react';
+import { Navigate, useLocation, useNavigate } from 'react-router-dom';
+import { ApiError } from '../lib/api';
+import { useAuth } from '../lib/auth';
+
+export default function LoginPage() {
+  const { user, login } = useAuth();
+  const navigate = useNavigate();
+  const location = useLocation();
+  const from = (location.state as { from?: string } | null)?.from ?? '/';
+
+  const [ma, setMa] = useState('');
+  const [matKhau, setMatKhau] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  if (user) return <Navigate to={from} replace />;
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    if (!ma.trim() || !matKhau) {
+      setError('Vui lòng nhập mã nhân viên và mật khẩu.');
+      return;
+    }
+    setBusy(true);
+    setError(null);
+    try {
+      await login(ma.trim(), matKhau);
+      navigate(from, { replace: true });
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'Đăng nhập thất bại.');
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="login-page">
+      <form className="login-card" onSubmit={submit} noValidate>
+        <div className="login-head">
+          <span className="brand-mark big" aria-hidden="true">
+            🛒
+          </span>
+          <h1>Đăng nhập</h1>
+          <p>Hệ thống quản lý cửa hàng thực phẩm</p>
+        </div>
+        <label className="field">
+          <span>Mã nhân viên</span>
+          <input
+            autoFocus
+            autoComplete="username"
+            value={ma}
+            onChange={(e) => setMa(e.target.value)}
+            placeholder="VD: admin"
+          />
+        </label>
+        <label className="field">
+          <span>Mật khẩu</span>
+          <input
+            type="password"
+            autoComplete="current-password"
+            value={matKhau}
+            onChange={(e) => setMatKhau(e.target.value)}
+          />
+        </label>
+        {error && (
+          <div className="alert alert-error" role="alert">
+            {error}
+          </div>
+        )}
+        <button className="btn btn-primary btn-block" type="submit" disabled={busy}>
+          {busy ? 'Đang đăng nhập…' : 'Đăng nhập'}
+        </button>
+      </form>
+    </div>
+  );
+}
diff --git a/web/frontend/src/pages/SanPhamPage.tsx b/web/frontend/src/pages/SanPhamPage.tsx
new file mode 100644
index 0000000..289d305
--- /dev/null
+++ b/web/frontend/src/pages/SanPhamPage.tsx
@@ -0,0 +1,319 @@
+import { cloneElement, useMemo, useState, type FormEvent, type ReactElement } from 'react';
+import { ApiError, api } from '../lib/api';
+import { useAuth } from '../lib/auth';
+import { formatMoney, formatNumber, normalize, parseMoneyInput } from '../lib/format';
+import type { LoaiSanPham, SanPham, SanPhamInput } from '../lib/types';
+import { ConfirmDialog, Empty, ErrorState, Loading, Modal, useLoad, useToast } from '../components/ui';
+
+type SortKey = 'maSanPham' | 'tenSanPham' | 'gia' | 'soLuongTon';
+
+export default function SanPhamPage() {
+  const { isQuanLy } = useAuth();
+  const toast = useToast();
+  const list = useLoad(() => api.sanPham(), []);
+  const loai = useLoad(() => api.loaiSanPham(), []);
+
+  const [q, setQ] = useState('');
+  const [loaiFilter, setLoaiFilter] = useState('');
+  const [sort, setSort] = useState<{ key: SortKey; asc: boolean }>({ key: 'maSanPham', asc: true });
+  const [editing, setEditing] = useState<SanPham | 'new' | null>(null);
+  const [deleting, setDeleting] = useState<SanPham | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  // Lọc tại trình duyệt: danh sách nhỏ, gõ tới đâu lọc tới đó, không phân biệt dấu
+  const rows = useMemo(() => {
+    const k = normalize(q);
+    const data = (list.data ?? []).filter(
+      (s) =>
+        (!k || normalize(`${s.maSanPham} ${s.tenSanPham} ${s.moTa ?? ''}`).includes(k)) &&
+        (!loaiFilter || s.loai === loaiFilter),
+    );
+    const dir = sort.asc ? 1 : -1;
+    return [...data].sort((a, b) => {
+      const x = a[sort.key];
+      const y = b[sort.key];
+      return (typeof x === 'number' && typeof y === 'number' ? x - y : String(x).localeCompare(String(y), 'vi')) * dir;
+    });
+  }, [list.data, q, loaiFilter, sort]);
+
+  function toggleSort(key: SortKey) {
+    setSort((s) => (s.key === key ? { key, asc: !s.asc } : { key, asc: true }));
+  }
+
+  async function confirmDelete() {
+    if (!deleting) return;
+    setBusy(true);
+    try {
+      await api.xoaSanPham(deleting.maSanPham);
+      toast.success(`Đã xóa ${deleting.tenSanPham}`);
+      setDeleting(null);
+      list.reload();
+    } catch (e) {
+      toast.error((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const header = (key: SortKey, label: string, cls = '') => (
+    <th className={`sortable ${cls}`} onClick={() => toggleSort(key)} aria-sort={sort.key === key ? (sort.asc ? 'ascending' : 'descending') : 'none'}>
+      {label} {sort.key === key ? (sort.asc ? '▲' : '▼') : ''}
+    </th>
+  );
+
+  return (
+    <div className="page">
+      <header className="page-head">
+        <div>
+          <h1>Sản phẩm</h1>
+          <p className="muted">
+            {list.data ? `${rows.length} / ${list.data.length} sản phẩm` : ' '}
+            {!isQuanLy && ' · chỉ quản lý được thêm, sửa, xóa'}
+          </p>
+        </div>
+        {isQuanLy && (
+          <button className="btn btn-primary" onClick={() => setEditing('new')}>
+            + Thêm sản phẩm
+          </button>
+        )}
+      </header>
+
+      <div className="toolbar">
+        <input
+          className="search"
+          placeholder="Tìm theo mã, tên… (không cần dấu)"
+          value={q}
+          onChange={(e) => setQ(e.target.value)}
+          aria-label="Tìm sản phẩm"
+        />
+        <select value={loaiFilter} onChange={(e) => setLoaiFilter(e.target.value)} aria-label="Lọc theo loại">
+          <option value="">Tất cả loại</option>
+          {(loai.data ?? []).map((l) => (
+            <option key={l.maLoai} value={l.tenLoai}>
+              {l.tenLoai}
+            </option>
+          ))}
+        </select>
+      </div>
+
+      {list.loading && !list.data && <Loading />}
+      {list.error && <ErrorState message={list.error} onRetry={list.reload} />}
+      {list.data && rows.length === 0 && <Empty>Không có sản phẩm phù hợp.</Empty>}
+      {list.data && rows.length > 0 && (
+        <div className="table-wrap">
+          <table className="table">
+            <thead>
+              <tr>
+                {header('maSanPham', 'Mã')}
+                {header('tenSanPham', 'Tên sản phẩm')}
+                <th>Loại</th>
+                <th>ĐVT</th>
+                {header('gia', 'Giá', 'num')}
+                {header('soLuongTon', 'Tồn kho', 'num')}
+                {isQuanLy && <th className="num">Thao tác</th>}
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((s) => (
+                <tr key={s.maSanPham} onDoubleClick={() => isQuanLy && setEditing(s)}>
+                  <td className="mono">{s.maSanPham}</td>
+                  <td>
+                    <strong>{s.tenSanPham}</strong>
+                    {s.moTa && <small className="muted block">{s.moTa}</small>}
+                  </td>
+                  <td>{s.loai ?? '—'}</td>
+                  <td>{s.donViTinh ?? '—'}</td>
+                  <td className="num">{formatMoney(s.gia)}</td>
+                  <td className="num">
+                    <span className={s.soLuongTon <= 0 ? 'text-danger' : s.soLuongTon <= 30 ? 'text-warn' : ''}>
+                      {formatNumber(s.soLuongTon)}
+                    </span>
+                  </td>
+                  {isQuanLy && (
+                    <td className="num nowrap">
+                      <button className="btn btn-sm" onClick={() => setEditing(s)}>
+                        Sửa
+                      </button>{' '}
+                      <button className="btn btn-sm btn-danger-ghost" onClick={() => setDeleting(s)}>
+                        Xóa
+                      </button>
+                    </td>
+                  )}
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+
+      {editing && (
+        <SanPhamForm
+          initial={editing === 'new' ? null : editing}
+          loai={loai.data ?? []}
+          onClose={() => setEditing(null)}
+          onSaved={(sp, isNew) => {
+            toast.success(isNew ? `Đã thêm ${sp.tenSanPham}` : `Đã lưu ${sp.tenSanPham}`);
+            setEditing(null);
+            list.reload();
+          }}
+        />
+      )}
+      {deleting && (
+        <ConfirmDialog
+          title="Xóa sản phẩm"
+          message={
+            <>
+              Xóa <strong>{deleting.tenSanPham}</strong> ({deleting.maSanPham})? Sản phẩm đã có trong hóa đơn hoặc phiếu
+              nhập sẽ không xóa được.
+            </>
+          }
+          confirmText="Xóa"
+          danger
+          busy={busy}
+          onConfirm={confirmDelete}
+          onCancel={() => setDeleting(null)}
+        />
+      )}
+    </div>
+  );
+}
+
+function SanPhamForm({
+  initial,
+  loai,
+  onClose,
+  onSaved,
+}: {
+  initial: SanPham | null;
+  loai: LoaiSanPham[];
+  onClose: () => void;
+  onSaved: (sp: SanPham, isNew: boolean) => void;
+}) {
+  const isNew = initial === null;
+  const [f, setF] = useState({
+    maSanPham: initial?.maSanPham ?? '',
+    maNhom: initial?.maNhom ?? '',
+    tenSanPham: initial?.tenSanPham ?? '',
+    loai: initial?.loai ?? loai[0]?.tenLoai ?? '',
+    donViTinh: initial?.donViTinh ?? 'Kg',
+    hanSuDung: initial?.hanSuDung ?? '',
+    moTa: initial?.moTa ?? '',
+    gia: initial ? formatNumber(initial.gia) : '',
+    soLuongTon: initial ? String(initial.soLuongTon) : '0',
+  });
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [formError, setFormError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const set = (k: keyof typeof f) => (e: { target: { value: string } }) => setF({ ...f, [k]: e.target.value });
+
+  function validate(): Record<string, string> {
+    const e: Record<string, string> = {};
+    if (isNew && !f.maSanPham.trim()) e.maSanPham = 'Vui lòng nhập mã sản phẩm';
+    else if (isNew && !/^[A-Za-z0-9_-]+$/.test(f.maSanPham.trim())) e.maSanPham = 'Mã chỉ gồm chữ, số, - và _';
+    if (!f.tenSanPham.trim()) e.tenSanPham = 'Vui lòng nhập tên sản phẩm';
+    if (!f.donViTinh.trim()) e.donViTinh = 'Vui lòng nhập đơn vị tính';
+    const gia = parseMoneyInput(f.gia);
+    if (gia === null || gia < 0) e.gia = 'Giá phải là số không âm';
+    if (!/^\d+$/.test(f.soLuongTon.trim())) e.soLuongTon = 'Tồn kho là số nguyên không âm';
+    if (f.hanSuDung.trim() && !/^\d{1,5}$/.test(f.hanSuDung.trim())) e.hanSuDung = 'Hạn sử dụng là số ngày';
+    return e;
+  }
+
+  async function submit(ev: FormEvent) {
+    ev.preventDefault();
+    const e = validate();
+    setErrors(e);
+    setFormError(null);
+    if (Object.keys(e).length) return;
+
+    const body: SanPhamInput = {
+      maSanPham: f.maSanPham.trim(),
+      maNhom: f.maNhom.trim() || null,
+      tenSanPham: f.tenSanPham.trim(),
+      loai: f.loai || null,
+      donViTinh: f.donViTinh.trim(),
+      hanSuDung: f.hanSuDung.trim() || null,
+      moTa: f.moTa.trim() || null,
+      gia: parseMoneyInput(f.gia),
+      soLuongTon: Number(f.soLuongTon.trim()),
+    };
+    setBusy(true);
+    try {
+      const saved = isNew ? await api.themSanPham(body) : await api.suaSanPham(initial.maSanPham, body);
+      onSaved(saved, isNew);
+    } catch (err) {
+      if (err instanceof ApiError) {
+        setErrors(err.fieldErrors);
+        setFormError(err.message);
+      } else {
+        setFormError('Không lưu được sản phẩm.');
+      }
+      setBusy(false);
+    }
+  }
+
+  const field = (k: keyof typeof f, label: string, input: ReactElement<Record<string, unknown>>, hint?: string) => {
+    const id = `sp-${k}`;
+    const msg = errors[k] ?? hint;
+    return (
+      <div className={`field${errors[k] ? ' has-error' : ''}`}>
+        <label htmlFor={id}>{label}</label>
+        {cloneElement(input, {
+          id,
+          'aria-invalid': errors[k] ? true : undefined,
+          'aria-describedby': msg ? `${id}-msg` : undefined,
+        })}
+        {msg && (
+          <em id={`${id}-msg`} className={errors[k] ? 'field-error' : 'field-hint'}>
+            {msg}
+          </em>
+        )}
+      </div>
+    );
+  };
+
+  return (
+    <Modal
+      title={isNew ? 'Thêm sản phẩm' : `Sửa sản phẩm ${initial.maSanPham}`}
+      onClose={onClose}
+      footer={
+        <>
+          <button className="btn" type="button" onClick={onClose} disabled={busy}>
+            Hủy
+          </button>
+          <button className="btn btn-primary" type="submit" form="sp-form" disabled={busy}>
+            {busy ? 'Đang lưu…' : 'Lưu'}
+          </button>
+        </>
+      }
+    >
+      <form id="sp-form" className="form-grid" onSubmit={submit} noValidate>
+        {field('maSanPham', 'Mã sản phẩm *', <input value={f.maSanPham} onChange={set('maSanPham')} disabled={!isNew} placeholder="VD: SP011" autoFocus={isNew} />, isNew ? undefined : 'Không thể đổi mã khi sửa')}
+        {field('maNhom', 'Mã nhóm', <input value={f.maNhom} onChange={set('maNhom')} placeholder="VD: RC04" />)}
+        <div className="span-2">
+          {field('tenSanPham', 'Tên sản phẩm *', <input value={f.tenSanPham} onChange={set('tenSanPham')} placeholder="VD: Bắp cải" autoFocus={!isNew} />)}
+        </div>
+        {field(
+          'loai',
+          'Loại',
+          <select value={f.loai} onChange={set('loai')}>
+            <option value="">— Không chọn —</option>
+            {loai.map((l) => (
+              <option key={l.maLoai} value={l.tenLoai}>
+                {l.tenLoai}
+              </option>
+            ))}
+            {f.loai && !loai.some((l) => l.tenLoai === f.loai) && <option value={f.loai}>{f.loai}</option>}
+          </select>,
+        )}
+        {field('donViTinh', 'Đơn vị tính *', <input value={f.donViTinh} onChange={set('donViTinh')} placeholder="Kg, Hộp, Chai…" />)}
+        {field('gia', 'Giá bán (đồng) *', <input value={f.gia} onChange={set('gia')} inputMode="numeric" placeholder="VD: 25.000" />)}
+        {field('soLuongTon', 'Tồn kho *', <input value={f.soLuongTon} onChange={set('soLuongTon')} inputMode="numeric" />)}
+        {field('hanSuDung', 'Hạn sử dụng (ngày)', <input value={f.hanSuDung} onChange={set('hanSuDung')} inputMode="numeric" placeholder="VD: 7" />)}
+        <div className="span-2">{field('moTa', 'Mô tả', <input value={f.moTa} onChange={set('moTa')} />)}</div>
+      </form>
+      {formError && <div className="alert alert-error">{formError}</div>}
+    </Modal>
+  );
+}
diff --git a/web/frontend/src/styles.css b/web/frontend/src/styles.css
