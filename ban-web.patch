+import { formatDate, formatMoney, formatMoneyShort, normalize, parseMoneyInput } from './format';
+
+describe('format', () => {
+  it('định dạng tiền Việt Nam', () => {
+    expect(formatMoney(1234567)).toBe('1.234.567 ₫');
+    expect(formatMoney(null)).toBe('—');
+    expect(formatMoneyShort(2_500_000)).toBe('2,5 tr ₫');
+    expect(formatMoneyShort(1_200_000_000)).toBe('1,2 tỷ ₫');
+  });
+
+  it('đổi ngày ISO sang dd/MM/yyyy không lệch múi giờ', () => {
+    expect(formatDate('2026-01-05')).toBe('05/01/2026');
+    expect(formatDate(null)).toBe('—');
+  });
+
+  it('bỏ dấu tiếng Việt để tìm kiếm', () => {
+    expect(normalize('Sữa Đậu Nành')).toBe('sua dau nanh');
+    expect(normalize('Thịt bò').includes(normalize('thit bo'))).toBe(true);
+  });
+
+  it('đọc số tiền người dùng nhập', () => {
+    expect(parseMoneyInput('8.000.000')).toBe(8000000);
+    expect(parseMoneyInput('25000')).toBe(25000);
+    expect(parseMoneyInput('')).toBeNull();
+    expect(parseMoneyInput('abc')).toBeNull();
+  });
+});
diff --git a/web/frontend/src/lib/format.ts b/web/frontend/src/lib/format.ts
new file mode 100644
index 0000000..5cc4c3f
--- /dev/null
+++ b/web/frontend/src/lib/format.ts
@@ -0,0 +1,51 @@
+const money = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 });
+
+/** 1234567 → "1.234.567 ₫" */
+export function formatMoney(value: number | null | undefined): string {
+  if (value === null || value === undefined || Number.isNaN(value)) return '—';
+  return `${money.format(Math.round(value))} ₫`;
+}
+
+/** 1234567 → "1,2 tr" để hiển thị gọn trên thẻ số liệu */
+export function formatMoneyShort(value: number | null | undefined): string {
+  if (value === null || value === undefined) return '—';
+  const abs = Math.abs(value);
+  if (abs >= 1_000_000_000) return `${trim(value / 1_000_000_000)} tỷ ₫`;
+  if (abs >= 1_000_000) return `${trim(value / 1_000_000)} tr ₫`;
+  return formatMoney(value);
+}
+
+function trim(n: number): string {
+  return n.toLocaleString('vi-VN', { maximumFractionDigits: 1 });
+}
+
+export function formatNumber(value: number | null | undefined): string {
+  if (value === null || value === undefined) return '—';
+  return money.format(value);
+}
+
+/** "2026-11-20" → "20/11/2026" (không đổi múi giờ) */
+export function formatDate(iso: string | null | undefined): string {
+  if (!iso) return '—';
+  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
+  return m ? `${m[3]}/${m[2]}/${m[1]}` : iso;
+}
+
+/** Bỏ dấu tiếng Việt và viết thường – để tìm "sua" ra "Sữa". */
+export function normalize(text: string | null | undefined): string {
+  return (text ?? '')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .replace(/đ/g, 'd')
+    .replace(/Đ/g, 'D')
+    .toLowerCase()
+    .trim();
+}
+
+/** Đọc số người dùng nhập kiểu Việt Nam: "8.000.000" hoặc "8000000" → 8000000. */
+export function parseMoneyInput(text: string): number | null {
+  const cleaned = text.replace(/[\s.₫đ]/g, '').replace(',', '.');
+  if (cleaned === '') return null;
+  const n = Number(cleaned);
+  return Number.isFinite(n) ? n : null;
+}
