+    plan: free
+    region: singapore
+    dockerfilePath: ./web/backend/Dockerfile
+    dockerContext: ./web/backend
+    healthCheckPath: /actuator/health
+    buildFilter:
+      paths:
+        - web/backend/**
+    envVars:
