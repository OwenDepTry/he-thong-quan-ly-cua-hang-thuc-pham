+      - type: rewrite
+        source: /*
+        destination: /index.html
+    envVars:
+      - key: VITE_API_URL    # URL của backend, VD https://qlcuahang-backend.onrender.com
+        sync: false
+      - key: NODE_VERSION    # Vite 8 cần Node >= 20.19
+        value: "22"
