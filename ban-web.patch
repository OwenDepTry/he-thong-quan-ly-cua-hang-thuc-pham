+++ b/web/frontend/src/styles.css
@@ -0,0 +1,263 @@
+:root {
+  --bg: #f4f6f3;
+  --surface: #ffffff;
+  --surface-2: #f8faf7;
+  --border: #e2e7df;
+  --text: #1c2620;
+  --muted: #66746b;
+  --primary: #1f7a4d;
+  --primary-hover: #19663f;
+  --primary-soft: #e6f3ec;
+  --warn: #b26a00;
+  --warn-soft: #fff4e0;
+  --danger: #c0392b;
+  --danger-soft: #fdecea;
+  --sidebar: #163b2a;
+  --sidebar-text: #d7e8de;
+  --sidebar-muted: #8fb3a0;
+  --radius: 10px;
+  --shadow: 0 1px 2px rgba(16, 40, 28, 0.06), 0 4px 16px rgba(16, 40, 28, 0.05);
+  --font: 'Inter', 'Segoe UI', system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif;
+  color-scheme: light;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0f1612;
+    --surface: #17211b;
+    --surface-2: #1c2821;
+    --border: #2a3830;
+    --text: #e4ece7;
+    --muted: #93a39a;
+    --primary: #3aa771;
+    --primary-hover: #49b981;
+    --primary-soft: #1b3326;
+    --warn: #f0a840;
+    --warn-soft: #33270f;
+    --danger: #ef6b5d;
+    --danger-soft: #3a1c19;
+    --sidebar: #0b120e;
+    --shadow: none;
+    color-scheme: dark;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body, #root { height: 100%; }
+body {
+  margin: 0;
+  font-family: var(--font);
+  font-size: 14px;
+  line-height: 1.5;
+  color: var(--text);
+  background: var(--bg);
+  -webkit-font-smoothing: antialiased;
+}
+h1, h2 { margin: 0; line-height: 1.25; }
+h1 { font-size: 22px; font-weight: 700; }
+h2 { font-size: 15px; font-weight: 650; }
+p { margin: 0; }
+a { color: var(--primary); }
+
+.muted { color: var(--muted); }
+.small { font-size: 12.5px; }
+.block { display: block; }
+.mono { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 13px; }
+.nowrap { white-space: nowrap; }
+.text-warn { color: var(--warn); font-weight: 600; }
+.text-danger { color: var(--danger); font-weight: 600; }
+.link { text-decoration: none; font-weight: 600; }
+
+/* ---------- Layout ---------- */
+.app { display: flex; min-height: 100%; }
+.sidebar {
+  width: 236px; flex-shrink: 0; background: var(--sidebar); color: var(--sidebar-text);
+  display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;
+}
+.brand { display: flex; gap: 10px; align-items: center; padding: 20px 18px; }
+.brand strong { display: block; color: #fff; font-size: 14.5px; }
+.brand small { color: var(--sidebar-muted); font-size: 12px; }
+.brand-mark {
+  width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,.1);
+  display: grid; place-items: center; font-size: 18px;
+}
+.brand-mark.big { width: 56px; height: 56px; font-size: 28px; background: var(--primary-soft); margin: 0 auto 10px; }
+.sidebar nav { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; flex: 1; }
+.sidebar nav a {
+  display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px;
+  color: var(--sidebar-text); text-decoration: none; font-weight: 500;
+}
+.sidebar nav a:hover { background: rgba(255,255,255,.06); }
+.sidebar nav a.active { background: var(--primary); color: #fff; }
+.nav-icon { width: 18px; text-align: center; opacity: .9; }
+.sidebar-user {
+  display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; align-items: center;
+  padding: 14px 16px; border-top: 1px solid rgba(255,255,255,.08);
+}
+.sidebar-user .btn { grid-column: 1 / -1; color: var(--sidebar-text); border-color: rgba(255,255,255,.15); }
+.avatar {
+  width: 34px; height: 34px; border-radius: 50%; background: var(--primary); color: #fff;
+  display: grid; place-items: center; font-weight: 700;
+}
+.who { min-width: 0; }
+.who strong { display: block; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13.5px; }
+.who small { color: var(--sidebar-muted); font-size: 12px; }
+.content { flex: 1; min-width: 0; }
+.page { padding: 26px 30px 40px; max-width: 1280px; }
+.page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
+.page-head p { margin-top: 4px; }
+.actions { display: flex; gap: 8px; }
+
+/* ---------- Controls ---------- */
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
+  height: 36px; padding: 0 14px; border-radius: 8px; border: 1px solid var(--border);
+  background: var(--surface); color: var(--text); font: inherit; font-weight: 600;
+  cursor: pointer; text-decoration: none; white-space: nowrap;
+}
+.btn:hover:not(:disabled) { border-color: var(--primary); }
+.btn:disabled { opacity: .55; cursor: not-allowed; }
+.btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
+.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
+.btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }
+.btn-danger-ghost { color: var(--danger); }
+.btn-danger-ghost:hover:not(:disabled) { border-color: var(--danger); background: var(--danger-soft); }
+.btn-ghost { background: transparent; }
+.btn-sm { height: 30px; padding: 0 10px; font-size: 13px; }
+.btn-block { width: 100%; height: 42px; }
+.icon-btn {
+  border: 0; background: transparent; color: var(--muted); font-size: 20px; line-height: 1;
+  width: 28px; height: 28px; border-radius: 6px; cursor: pointer;
+}
+.icon-btn:hover { background: var(--surface-2); color: var(--danger); }
+
+input, select {
+  font: inherit; color: var(--text); background: var(--surface); height: 36px; padding: 0 10px;
+  border: 1px solid var(--border); border-radius: 8px; outline: none; min-width: 0;
+}
+input:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-soft); }
+input:disabled { background: var(--surface-2); color: var(--muted); }
+.field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
+.field > span, .field > label { font-weight: 600; font-size: 13px; }
+.field.has-error input, .field.has-error select { border-color: var(--danger); }
+.field-error { color: var(--danger); font-size: 12.5px; font-style: normal; }
+.field-hint { color: var(--muted); font-size: 12.5px; font-style: normal; }
+.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
+.form-grid .span-2 { grid-column: 1 / -1; }
+.toolbar { display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
+.toolbar .search { flex: 1; min-width: 220px; }
+.inline { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-weight: 600; }
+.search { width: 100%; }
+
+.alert { padding: 10px 12px; border-radius: 8px; margin: 10px 0; font-weight: 500; }
+.alert-error { background: var(--danger-soft); color: var(--danger); }
+
+/* ---------- Cards / stats ---------- */
+.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow); }
+.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
+.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }
+.stat {
+  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
+  padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; box-shadow: var(--shadow);
+}
+.stat-label { color: var(--muted); font-weight: 600; font-size: 12.5px; text-transform: uppercase; letter-spacing: .03em; }
+.stat-value { font-size: 24px; font-weight: 750; font-variant-numeric: tabular-nums; }
+.stat-sub { color: var(--muted); font-size: 13px; }
+.stat-sub.warn { color: var(--warn); font-weight: 600; }
+.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
+.list { list-style: none; padding: 0; margin: 12px 0 8px; }
+.list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 9px 0; border-top: 1px solid var(--border); }
+.list li:first-child { border-top: 0; }
+.list strong { display: block; }
+.list small { font-size: 12.5px; }
+.badge { min-width: 26px; padding: 1px 8px; border-radius: 999px; font-weight: 700; font-size: 12.5px; text-align: center; }
+.badge-warn { background: var(--warn-soft); color: var(--warn); }
+.badge-danger { background: var(--danger-soft); color: var(--danger); }
+.pill { padding: 2px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
+.pill-warn { background: var(--warn-soft); color: var(--warn); }
+.pill-danger { background: var(--danger-soft); color: var(--danger); }
+
+/* ---------- Tables ---------- */
+.table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: auto; box-shadow: var(--shadow); }
+.table { width: 100%; border-collapse: collapse; }
+.table th, .table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: middle; }
+.table th { font-size: 12.5px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); background: var(--surface-2); font-weight: 650; position: sticky; top: 0; }
+.table tbody tr:last-child td { border-bottom: 0; }
+.table tbody tr:hover { background: var(--surface-2); }
+.table .num { text-align: right; font-variant-numeric: tabular-nums; }
+.table th.sortable { cursor: pointer; user-select: none; }
+.table tr.clickable { cursor: pointer; }
+.table-compact th, .table-compact td { padding: 7px 8px; }
+.pager { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 12px; color: var(--muted); }
+
+/* ---------- POS ---------- */
+.pos { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(340px, 1fr); gap: 14px; align-items: start; }
+.pos-products .search { margin-bottom: 12px; }
+.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; max-height: calc(100vh - 230px); overflow: auto; }
+.product-tile {
+  text-align: left; border: 1px solid var(--border); background: var(--surface-2); border-radius: 9px;
+  padding: 10px 12px; cursor: pointer; display: flex; flex-direction: column; gap: 2px; font: inherit; color: var(--text);
+}
+.product-tile:hover { border-color: var(--primary); background: var(--primary-soft); }
+.product-tile.disabled { opacity: .5; }
+.product-tile .price { color: var(--primary); font-weight: 700; }
+.pos-cart { position: sticky; top: 16px; display: flex; flex-direction: column; gap: 10px; }
+.pos-cart h2 { margin-bottom: 4px; }
+.empty-cart { padding: 22px 0; text-align: center; border: 1px dashed var(--border); border-radius: 8px; }
+.qty { width: 70px; text-align: right; height: 32px; }
+.totals { border-top: 1px solid var(--border); padding-top: 10px; display: flex; flex-direction: column; gap: 4px; }
+.totals div { display: flex; justify-content: space-between; font-variant-numeric: tabular-nums; }
+.totals .grand { font-size: 18px; margin-top: 4px; }
+.totals .grand strong { color: var(--primary); }
+.pos-actions { display: flex; gap: 8px; justify-content: flex-end; }
+.pos-actions .btn-primary { flex: 1; height: 42px; }
+
+/* ---------- Invoice ---------- */
+.invoice .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; margin: 0 0 14px; }
+.invoice dt { color: var(--muted); font-size: 12.5px; }
+.invoice dd { margin: 0; font-weight: 600; }
+
+/* ---------- Modal ---------- */
+.modal-backdrop { position: fixed; inset: 0; background: rgba(10, 20, 14, .45); display: grid; place-items: center; z-index: 50; padding: 16px; }
+.modal { background: var(--surface); border-radius: 12px; width: min(560px, 100%); max-height: calc(100vh - 32px); display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
+.modal-wide { width: min(760px, 100%); }
+.modal-head { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border); }
+.modal-head h2 { font-size: 17px; }
+.modal-body { padding: 18px 20px; overflow: auto; }
+.modal-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 20px; border-top: 1px solid var(--border); }
+
+/* ---------- Toast & states ---------- */
+.toasts { position: fixed; right: 18px; bottom: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 60; }
+.toast { padding: 11px 16px; border-radius: 9px; color: #fff; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.18); max-width: 380px; animation: slide .2s ease-out; }
+.toast-success { background: var(--primary); }
+.toast-error { background: var(--danger); }
+.toast-info { background: #2d4a3b; }
+@keyframes slide { from { transform: translateY(8px); opacity: 0; } }
+.state { padding: 40px 20px; text-align: center; color: var(--muted); display: flex; flex-direction: column; align-items: center; gap: 10px; }
+.state-error { color: var(--danger); }
+.spinner { width: 22px; height: 22px; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin .8s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* ---------- Login ---------- */
+.login-page { min-height: 100%; display: grid; place-items: center; padding: 20px; background: radial-gradient(circle at 20% 10%, var(--primary-soft), transparent 50%), var(--bg); }
+.login-card { width: min(380px, 100%); background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 30px 28px; box-shadow: var(--shadow); }
+.login-head { text-align: center; margin-bottom: 20px; }
+.login-head p { color: var(--muted); margin-top: 4px; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1100px) {
+  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .pos { grid-template-columns: 1fr; }
+  .pos-cart { position: static; }
+}
+@media (max-width: 760px) {
+  .app { flex-direction: column; }
+  .sidebar { width: 100%; height: auto; position: static; }
+  .sidebar nav { flex-direction: row; overflow-x: auto; padding: 0 10px 10px; }
+  .sidebar nav a { white-space: nowrap; padding: 8px 12px; }
+  .sidebar-user { grid-template-columns: auto 1fr auto; padding: 8px 16px; }
+  .sidebar-user .btn { grid-column: auto; }
+  .brand { padding: 12px 16px; }
+  .page { padding: 18px 14px 30px; }
+  .grid-2, .form-grid { grid-template-columns: 1fr; }
+}
