# Sao chép file này thành "db.properties" (cùng thư mục) nếu muốn đổi thông tin kết nối.
# Không có db.properties thì app dùng mặc định bên dưới – khớp với docker-compose.yml,
# nên chạy "docker compose up -d" là kết nối được ngay.
# db.properties đã nằm trong .gitignore nên mật khẩu sẽ không bị đẩy lên GitHub.
# Có thể ghi đè bằng biến môi trường DB_URL, DB_USER, DB_PASSWORD.

# stringtype=unspecified: cho phép truyền ngày/số dạng chuỗi như khi dùng MySQL
db.url=jdbc:postgresql://127.0.0.1:55432/qlcuahangthucpham?stringtype=unspecified
db.user=postgres
db.password=postgres
